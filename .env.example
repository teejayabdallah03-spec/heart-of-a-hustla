# Copy this file to .env and use a Stripe test API key first (sk_test_ or rk_test_).
# A restricted key is recommended; keep all secret/restricted keys server-side.
# Never put Stripe API keys in app.js, HTML, or any other browser file.
STRIPE_SECRET_KEY=

# Set this to the public HTTPS address when deploying.
PUBLIC_BASE_URL=http://localhost:4173
PORT=4173
HOST=127.0.0.1

# Live charges require HTTPS, NODE_ENV=production, and explicit opt-in.
STRIPE_LIVE_PAYMENTS=false
