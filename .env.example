# Copy this file to .env and use your Stripe account's test secret key first.
# Never put Stripe secret keys in app.js, HTML, or any other browser file.
STRIPE_SECRET_KEY=

# Set this to the public HTTPS address when deploying.
PUBLIC_BASE_URL=http://localhost:4173
PORT=4173
HOST=127.0.0.1

# Live charges require HTTPS, NODE_ENV=production, and explicit opt-in.
STRIPE_LIVE_PAYMENTS=false
